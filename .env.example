# ---------------------------------------------------------------------------
# Environment template. Copy to `.env.local` for local dev and set real values
# there. NEVER commit `.env`, `.env.local`, or any file containing real keys.
# On Vercel, set these in Project Settings -> Environment Variables (not in git).
#
# STATUS TODAY: the app ships with the offline Mock AI provider hard-wired, so it
# runs with ZERO configuration and ZERO secrets. Every variable below is a
# placeholder for when a real, SERVER-SIDE provider is wired behind /api/ai.
# None of them are read by the browser.
# ---------------------------------------------------------------------------

# AI provider selector. Reserved for when real providers are added.
# Supported today: "mock" (default, offline, no key).
# Planned: "openrouter" | "anthropic" | "ollama".
AI_PROVIDER=mock

# --- Anthropic (planned, SERVER-ONLY) --------------------------------------
# Real LLM key. NEVER prefix with NEXT_PUBLIC_. Never sent to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenRouter (planned, SERVER-ONLY) -------------------------------------
# Remote-model testing. NEVER prefix with NEXT_PUBLIC_. The model is
# intentionally configurable — do not hard-code a specific free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Ollama (planned, local models) ----------------------------------------
# Base URL of a local Ollama server, e.g. http://127.0.0.1:11434
OLLAMA_BASE_URL=

# ---------------------------------------------------------------------------
# NOT USED YET (intentionally absent): there is no database and no auth in the
# MVP. Profiles are stored client-side in the browser (localStorage). So there
# is deliberately no DATABASE_URL and no NEXTAUTH_SECRET. Add them only when the
# corresponding features (persistence / accounts) are actually implemented.
# ---------------------------------------------------------------------------
